# Local environment and secrets
.env
.env.*
!.env.example
# Bitrix core stays outside Git. Preserve only empty runtime mountpoints needed
# by the read-only production-like bind mount.
/bitrix/*
!/bitrix/cache/
!/bitrix/managed_cache/
!/bitrix/stack_cache/
/bitrix/cache/*
/bitrix/managed_cache/*
/bitrix/stack_cache/*
!/bitrix/cache/.gitkeep
!/bitrix/managed_cache/.gitkeep
!/bitrix/stack_cache/.gitkeep
/include/contacts-site-map.php

# Runtime and user-generated data
/upload/*
!/upload/.gitkeep
/.cache/
/local/cache/
/local/managed_cache/
/local/php_interface/logs/*
!/local/php_interface/logs/.gitkeep
*.log

# Dependency and test artifacts
/node_modules/
/test-results/
/playwright-report/
/blob-report/
/coverage/

# Docker runtime data and private database dumps
/docker/db/data/
/docker/db/init/*.sql
/docker/db/init/*.sql.gz
/docker/db/init/*.dump
/*.sql
/*.sql.gz
/*.dump

# Local archives and editor/OS files
*.tar.gz
*.zip
Thumbs.db
.DS_Store
.idea/
.vscode/
